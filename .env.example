# The public origin. Feeds metadataBase, canonicals, sitemap.xml, robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.blueprintdigital.my

# One passcode per client document under /proposals. Each carries another
# company's pricing, so proxy.ts gates them and a code given to one client
# opens only that client's document. With a variable unset, proxy.ts falls
# back to the value recorded beside it in DOCUMENTS; set it here to make the
# passcode a real secret. Never commit real values; this repository is public.
PROPOSAL_PASSCODE=            # /proposals/bangkok-thai
PROPOSAL_PASSCODE_JNA=        # /proposals/jna-real-estate
